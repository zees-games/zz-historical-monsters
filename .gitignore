# Godot 4
.godot/
.import/

# The gs-* addons are separate repositories and are linked in, never committed.
# bootstrap.sh derives this project's dependencies from the lines below.
/addons/gs_core
/addons/gs_profile
/addons/gs_npc
/addons/gs_npc_ai
# Test only: the two-peer replication suite (examples/zhm_net.gd) and the shot suite (zhm_shoot.gd). The addon never names them.
/addons/gs_net
/addons/gs_combat

# Exports
build/
export.cfg
export_presets.cfg
*.translation

# Screenshots are evidence for a review, not assets.
/screenshots/

.DS_Store
Thumbs.db
.vscode/
__pycache__/
art-src/reference/
/tools/readme_studio/
/.gs-pack

