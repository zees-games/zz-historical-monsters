; Engine configuration file.
config_version=5

[application]

config/name="zz-historical-monsters"
config/description="Zee's Historical Monsters: infected, mutated versions of realistic animals (T-Rex, tiger, bear) that hunt and kill players, each with special attacks. An addon for Zombie Zone and any other Dot game."
run/main_scene="res://examples/zhm_gallery.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/zz_historical_monsters/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
